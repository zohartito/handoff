{
  "name": "@zohartito/handoff",
  "version": "0.9.2",
  "description": "Frozen Handoff release: refusal-only CLI and manual integration removal guidance.",
  "type": "module",
  "bin": {
    "handoff": "./bin/handoff.mjs"
  },
  "exports": {
    ".": "./dist/frozen.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/handoff.mjs",
    "dist/cli.js",
    "dist/frozen.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/build-release.mjs",
    "check:release-surface": "node scripts/check-release-surface.mjs",
    "start": "node dist/cli.js",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "test:watch": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs --watch",
    "prepack": "node scripts/build-release.mjs",
    "prepublishOnly": "node scripts/check-release-surface.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "handoff",
    "claude",
    "claude-code",
    "claude-desktop",
    "cursor",
    "codex",
    "gemini",
    "cli",
    "context",
    "session",
    "llm"
  ],
  "license": "MIT",
  "author": "Zohar Tito",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zohartito/handoff.git"
  },
  "bugs": {
    "url": "https://github.com/zohartito/handoff/issues"
  },
  "homepage": "https://github.com/zohartito/handoff#readme",
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.5"
  }
}
